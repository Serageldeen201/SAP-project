### Variables
@host = http://localhost:4004
@adminAuth = Basic alice:
@userAuth = Basic bob:

###############################################################################
# 1. SUPPLIERS CRUD
###############################################################################

### 1.1 List all Suppliers
GET {{host}}/catalog/Suppliers
Authorization: {{adminAuth}}

### 1.2 Get Single Supplier by ID
GET {{host}}/catalog/Suppliers(11111111-1111-1111-1111-111111111111)
Authorization: {{adminAuth}}

### 1.3 Create a New Supplier (Valid Rating 1-5)
# @name createSupplier
POST {{host}}/catalog/Suppliers
Authorization: {{adminAuth}}
Content-Type: application/json

{
    "name": "Apex Global Supply",
    "email": "contact@apexsupply.com",
    "rating": 5
}

### 1.4 Create Supplier with Invalid Rating (> 5) -> Expects 400 Bad Request
POST {{host}}/catalog/Suppliers
Authorization: {{adminAuth}}
Content-Type: application/json

{
    "name": "Invalid Rating Supplier",
    "email": "invalid@rating.com",
    "rating": 6
}

### 1.5 Update Supplier Rating
PATCH {{host}}/catalog/Suppliers(11111111-1111-1111-1111-111111111111)
Authorization: {{adminAuth}}
Content-Type: application/json

{
    "rating": 4
}

### 1.6 Delete Supplier
DELETE {{host}}/catalog/Suppliers(33333333-3333-3333-3333-333333333333)
Authorization: {{adminAuth}}


###############################################################################
# 2. PRODUCTS CRUD & EXTERNAL API ENRICHMENT
###############################################################################

### 2.1 List all Products (with Supplier and Reviews expanded)
GET {{host}}/catalog/Products?$expand=supplier,reviews
Authorization: {{adminAuth}}

### 2.2 List all Products (Standard)
GET {{host}}/catalog/Products
Authorization: {{adminAuth}}

### 2.3 Create a Product (Auto-enriches externalRating from FakeStoreAPI)
# @name createProduct
POST {{host}}/catalog/Products
Authorization: {{adminAuth}}
Content-Type: application/json

{
    "name": "Men's Casual Premium Slim Fit T-Shirts",
    "price": 29.99,
    "category": "men's clothing",
    "supplier_ID": "11111111-1111-1111-1111-111111111111"
}

### 2.4 Create another Product (Electronics Category)
POST {{host}}/catalog/Products
Authorization: {{adminAuth}}
Content-Type: application/json

{
    "name": "SanDisk SSD PLUS 1TB Internal SSD",
    "price": 109.00,
    "category": "electronics",
    "supplier_ID": "22222222-2222-2222-2222-222222222222"
}

### 2.5 Create Product with Invalid Price (<= 0) -> Expects 400 Bad Request
POST {{host}}/catalog/Products
Authorization: {{adminAuth}}
Content-Type: application/json

{
    "name": "Zero Price Item",
    "price": -10.00,
    "category": "electronics",
    "supplier_ID": "11111111-1111-1111-1111-111111111111"
}

### 2.6 Get Single Product by ID
GET {{host}}/catalog/Products(aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa)
Authorization: {{adminAuth}}


###############################################################################
# 3. PRODUCT REVIEWS & CUSTOM ACTION submitReview
###############################################################################

### 3.1 List all Product Reviews
GET {{host}}/catalog/ProductReviews
Authorization: {{adminAuth}}

### 3.2 Submit a Review via Custom Action (Updates averageRating on Product)
POST {{host}}/catalog/submitReview
Authorization: {{userAuth}}
Content-Type: application/json

{
    "productID": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
    "rating": 5,
    "comment": "Outstanding build quality and crystal clear sound!"
}

### 3.3 Submit a Review with Invalid Rating (> 5) -> Expects 400 Bad Request
POST {{host}}/catalog/submitReview
Authorization: {{userAuth}}
Content-Type: application/json

{
    "productID": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
    "rating": 7,
    "comment": "Rating is too high"
}

### 3.4 Submit a Review for Non-Existent Product -> Expects 404 Not Found
POST {{host}}/catalog/submitReview
Authorization: {{userAuth}}
Content-Type: application/json

{
    "productID": "00000000-0000-0000-0000-000000000000",
    "rating": 4,
    "comment": "Product does not exist"
}
