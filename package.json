{
  "name": "supplier-product-management",
  "version": "1.0.0",
  "description": "Supplier Product Management API using SAP CAP and TypeScript",
  "repository": "<Add your repository URL here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/sqlite": "^1.7.0",
    "@sap/cds": "^8.8.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@cap-js/cds-typer": "^0.33.0",
    "@cap-js/cds-types": "^0.9.0",
    "@sap/cds-dk": "^8.8.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "axios": "^1.7.9",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "tsc",
    "test": "mocha -r ts-node/register --timeout 30000 --exit test/catalog-service.test.ts"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "roles": [
                "admin",
                "user"
              ]
            },
            "bob": {
              "roles": [
                "user"
              ]
            }
          }
        }
      }
    },
    "features": {
      "typescript": true
    }
  }
}
